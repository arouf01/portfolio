# ---------------------------------------------------------------------------
# OLD HOSTING redirect for  arouf.a1zohosolutions.com
# Upload the CONTENTS of this folder into the old subdomain's document root
# (replacing the old app). Every request 301-redirects to the new subdomain,
# keeping the full path and query string so old links and SEO carry over.
# ---------------------------------------------------------------------------
RewriteEngine On

# Send everything to the new home (path + query string preserved).
RewriteRule ^(.*)$ https://abdur-rouf.a1flows.com/$1 [R=301,L]
